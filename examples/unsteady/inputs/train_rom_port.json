{
  "pathfile": "./../../../PATHS.txt",
  "env": {
    "backend": "torch",
    "device": "cuda",
    "device_idx": 0,
    "nb_threads": 8,
    "epsilon": 1e-10,
    "floatx": "float64",
    "seed": 0
  },

  "mesh": {
    "nx_intr": 48,
    "ny_intr": 48,
    "lx_sub": 0.5,
    "ly_sub": 0.5,
    "x0": 0.0,
    "y0": 0.0,
    "n_sub_x": 2,
    "n_sub_y": 2
  },

  "field": {
    "name": "SinMultiPeak",
    "kwargs": {
      "mu_lim": [0.5, 1.5],
      "forced_config": [1,0,0,0]
    }
  },

  "fom": {
    "name": "Burgers2D",
    "kwargs": {
      "nu": 1e-3
    }
  },

  "trainable": {
    "elements": ["port"],
    "ports": null,
    "subdomains": null,
    "merged": true
  },

  "data_load": {
  "n_workers": 32,
    "ranges": [0,2000],
    "key": "snapshots",
    "path": "/g/g92/zanardi1/Workspace/Codes/DD-NM-ROM/run/unsteady/dset.2by2/datagen/train/"
  },

  "data": {
    "validation_split": 0.2,
    "batch_size": 512
  },

  "autoencoder": {
    "dim": {
      "interior": {
        "latent_dim": 18,
        "row_shift": 5,
        "row_nonzero": 5
      },
      "interface": {
        "latent_dim": 12,
        "row_shift": 5,
        "row_nonzero": 5
      },
      "port": {
        "latent_dim": 6,
        "row_shift": 3,
        "row_nonzero": 3
      }
    },
    "common": {
      "min_input_dim": 5,
      "encoder_dense": false,
      "encoder_hidden": -1,
      "activation": "swish",
      "add_noise": true,
      "loading": false,
      "saved_model": ""
    }
  },

  "model": {
    "path": "/g/g92/zanardi1/Workspace/Codes/DD-NM-ROM/run/unsteady/dset.2by2/nets/run.mse.01",
    "compile": {
      "optimizer": "adam",
      "lr": 1e-3,
      "decay": {
        "name": "reduce_on_plateau",
        "factor": 0.8,
        "patience": 100,
        "min_lr": 1e-6
      },
      "loss": "mse",
      "monitor": "val_loss",
      "reduction": "mean",
      "callbacks": {
        "early_stopping": {
          "monitor": "val_loss",
          "min_delta": 1e-8,
          "patience": 500
        },
        "checkpoint": {
          "monitor": "val_loss",
          "save_best_only": true
        },
        "lr_tracker": {
          "verbose": true
        }
      }
    },
    "train": {
      "epochs": 2000,
      "display_freq": 100,
      "saving": true
    }
  }

}
